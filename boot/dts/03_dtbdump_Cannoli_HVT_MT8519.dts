/dts-v1/;

/ {
	model = "Cannoli HVT MT8519";
	compatible = "mediatek,cannoli\0mediatek,mt8519";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@10019100";
		i2c1 = "/soc/i2c@1001c100";
		i2c2 = "/soc/i2c@10013100";
		i2c3 = "/soc/i2c@11007000";
		i2c4 = "/soc/i2c@11008000";
		serial0 = "/soc/serial@11002000";
		serial1 = "/soc/serial@1000e000";
		serial2 = "/soc/serial@1000f000";
		ringled0 = "/soc/i2c@10019100/lp5036@31";
		display0 = "/soc/i2c@10019100/lp5036@30";
		display1 = "/soc/i2c@10019100/lp5036@32";
		display2 = "/soc/i2c@10019100/lp5036@33";
	};

	atf_logger {
		compatible = "mediatek,atf_logger";
		interrupts = <0x00 0xc3 0x01>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = <0x6553f100>;
			cpu-idle-states = <0x02 0x03 0x04>;
			performance-domains = <0x05 0x00>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = <0x6553f100>;
			cpu-idle-states = <0x02 0x03 0x04>;
			performance-domains = <0x05 0x00>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x07>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = <0x6553f100>;
			cpu-idle-states = <0x02 0x03 0x04>;
			performance-domains = <0x05 0x00>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x08>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0x40000200>;
			clock-frequency = <0x6553f100>;
			cpu-idle-states = <0x02 0x03 0x04>;
			performance-domains = <0x05 0x00>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x09>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpuoff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10001>;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x640>;
				phandle = <0x02>;
			};

			clusteroff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010001>;
				entry-latency-us = <0x64>;
				exit-latency-us = <0x15e>;
				min-residency-us = <0x834>;
				phandle = <0x03>;
			};

			mcusysoff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010002>;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x4b0>;
				min-residency-us = <0xa28>;
				phandle = <0x04>;
			};
		};
	};

	clocks {

		clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			phandle = <0x54>;
		};

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
			phandle = <0x13>;
		};

		clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xc65d40>;
			phandle = <0x18>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x55>;
		};
	};

	extcon_iddig {
		compatible = "linux,extcon-usb-gpio";
		status = "okay";
		id-gpios = <0x0a 0x10 0x00>;
		vbus-gpios = <0x0a 0x13 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x0b>;
		wakeup-source;
		phandle = <0x32>;
	};

	firmware {
		phandle = <0x56>;

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			clocks = <0x0c 0x1e 0x0c 0x1f 0x0d 0x13>;
			clock-names = "ECC\0GCPU\0GCPU_B";
		};
	};

	mtee {
		compatible = "mediatek,mtee";
		status = "disabled";
	};

	pmu {
		compatible = "arm,armv8-pmuv3\0arm,cortex-a7-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04>;
	};

	pmu-dsu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04>;
		cpus = <0x06 0x07 0x08 0x09>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		atf-logbuf-memory@42fc0000 {
			compatible = "mediatek,mt8512-atf-logbuf-memory";
			no-map;
			reg = <0x00 0x42fc0000 0x00 0x40000>;
		};

		atf-reserved-memory@43000000 {
			compatible = "mediatek,mt8512-atf-reserved-memory";
			no-map;
			reg = <0x00 0x43000000 0x00 0x30000>;
		};

		optee-reserved-memory@43040000 {
			compatible = "mediatek,mt8519-optee-reserved-memory";
			no-map;
			reg = <0x00 0x43040000 0x00 0x300000>;
		};

		mboot_params_reserved_memory {
			compatible = "mediatek,mt8519-mboot_params_reserved-memory";
			no-map;
			reg = <0x00 0x44400000 0x00 0x10000>;
		};

		ramoops@0x44410000 {
			compatible = "ramoops";
			no-map;
			reg = <0x00 0x44410000 0x00 0xe0000>;
			console-size = <0x40000>;
			pmsg-size = <0x10000>;
			record-size = <0x1000>;
			ftrace-size = <0x1000>;
		};

		minidump_reserved_memory {
			compatible = "mediatek,mt8519-minidump_reserved-memory";
			no-map;
			reg = <0x00 0x444f0000 0x00 0x10000>;
		};

		tinysys_mem_region {
			compatible = "mediatek,tinysys-reserved-memory";
			no-map;
			reg = <0x00 0x48000000 0x00 0xe0000>;
			phandle = <0x57>;
		};

		tinysys_ipc_rx_reserved {
			compatible = "amazon,tinysys-ipc-reserved-memory";
			no-map;
			reg = <0x00 0x480e0000 0x00 0x10000>;
			phandle = <0x3a>;
		};

		tinysys_ipc_tx_reserved {
			compatible = "amazon,tinysys-ipc-reserved-memory";
			no-map;
			reg = <0x00 0x480f0000 0x00 0x10000>;
			phandle = <0x3b>;
		};

		mrdump_cb_reserved_memory {
			compatible = "mediatek,mt8519-mrdump_cb-reserved-memory";
			no-map;
			reg = <0x00 0x44500000 0x00 0x2000>;
		};

		kedump-reserved-memory@44500000 {
			compatible = "mediatek,mt8519-kedump_reserved-memory";
			no-map;
			reg = <0x00 0x44502000 0x00 0x10000>;
		};

		adsp_mem_region {
			compatible = "mediatek,adsp-reserved-memory";
			no-map;
			reg = <0x00 0x50000000 0x00 0xf00000>;
			phandle = <0x23>;
		};

		acenna_reserved {
			compatible = "shared-dma-pool";
			size = <0x00 0x4000000>;
			reusable;
			phandle = <0x1f>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
		clock-frequency = <0xc65d40>;
		phandle = <0x58>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		cpuhvfs@105c00 {
			compatible = "mediatek,cpufreq-hybrid";
			reg = <0x00 0x105c00 0x00 0x400 0x00 0x10bd00 0x00 0x1300 0x00 0x105000 0x00 0x400>;
			reg-names = "USRAM\0CSRAM\0ESRAM";
			cslog-range = <0x578 0xd48>;
			tbl-off = <0x04 0x4c>;
			mcucfg-ver = <0x01>;
			apmixedsys = <0x0e>;
			clk-div-base = <0x0f>;
			pll-con = <0x310 0x3c4>;
			clk-div = <0xa2a0 0xa2e0>;
			proc1-supply = <0x10>;
			proc2-supply = <0x10>;
			phandle = <0x59>;
		};

		performance-controller@10bd10 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x00 0x10bd10 0x00 0x120>;
			#performance-domain-cells = <0x01>;
			phandle = <0x05>;
		};

		scp@338000 {
			compatible = "mediatek,mt8519-scp";
			reg = <0x00 0x280000 0x00 0x3f000 0x00 0x338000 0x00 0x1000 0x00 0x2bf000 0x00 0x100 0x00 0x33a000 0x00 0x04 0x00 0x33a00c 0x00 0x04 0x00 0x2bf100 0x00 0x100 0x00 0x33b000 0x00 0x04 0x00 0x33b00c 0x00 0x04 0x00 0x2bf200 0x00 0x100 0x00 0x33c000 0x00 0x04 0x00 0x33c00c 0x00 0x04 0x00 0x2bf300 0x00 0x100 0x00 0x33d000 0x00 0x04 0x00 0x33d00c 0x00 0x04 0x00 0x2bf400 0x00 0x100 0x00 0x33e000 0x00 0x04 0x00 0x33e00c 0x00 0x04>;
			reg-names = "sram\0cfg\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox1_base\0mbox1_set\0mbox1_clr\0mbox2_base\0mbox2_set\0mbox2_clr\0mbox3_base\0mbox3_set\0mbox3_clr\0mbox4_base\0mbox4_set\0mbox4_clr";
			interrupts = <0x00 0x10d 0x04 0x00 0x112 0x04 0x00 0x111 0x04 0x00 0x110 0x04 0x00 0x10f 0x04 0x00 0x10e 0x04>;
			interrupt-names = "wdt\0mbox0\0mbox1\0mbox2\0mbox3\0mbox4";
			clocks = <0x0c 0x06>;
			clock-names = "main";
			status = "okay";
			phandle = <0x5a>;
		};

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x01>;
			#redistributor-regions = <0x01>;
			interrupt-controller;
			reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};

		mcusys_ao_cfg@c530000 {
			reg = <0x00 0xc530000 0x00 0x10000>;
			phandle = <0x0f>;
		};

		mcupm@c540000 {
			compatible = "mediatek,mcupm";
			reg = <0x00 0xc540000 0x00 0x22000 0x00 0xc55fb00 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fba0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fc40 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fce0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fd80 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fe20 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fec0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55ff60 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04>;
			reg-names = "mcupm_base\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox0_send\0mbox0_recv\0mbox1_base\0mbox1_set\0mbox1_clr\0mbox1_send\0mbox1_recv\0mbox2_base\0mbox2_set\0mbox2_clr\0mbox2_send\0mbox2_recv\0mbox3_base\0mbox3_set\0mbox3_clr\0mbox3_send\0mbox3_recv\0mbox4_base\0mbox4_set\0mbox4_clr\0mbox4_send\0mbox4_recv\0mbox5_base\0mbox5_set\0mbox5_clr\0mbox5_send\0mbox5_recv\0mbox6_base\0mbox6_set\0mbox6_clr\0mbox6_send\0mbox6_recv\0mbox7_base\0mbox7_set\0mbox7_clr\0mbox7_send\0mbox7_recv";
			interrupts = <0x00 0x21 0x04 0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x28 0x04>;
			interrupt-names = "mbox0\0mbox1\0mbox2\0mbox3\0mbox4\0mbox5\0mbox6\0mbox7";
			phandle = <0x5b>;
		};

		syscon@10000000 {
			compatible = "mediatek,mt8519-topckgen\0syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x0c>;
		};

		syscon@10001000 {
			compatible = "mediatek,mt8519-infracfg_ao\0syscon\0simple-mfd";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x0d>;

			reset-controller {
				compatible = "ti,syscon-reset";
				#reset-cells = <0x01>;
				ti,reset-bits = <0x120 0x00 0x124 0x00 0x00 0x00 0x1c>;
				phandle = <0x5c>;
			};
		};

		syscon@10003000 {
			compatible = "mediatek,mt8519-pericfg\0syscon";
			reg = <0x00 0x10003000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x31>;
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt8519-pinctrl";
			reg = <0x00 0x10005000 0x00 0x1000 0x00 0x11f30000 0x00 0x1000 0x00 0x11f20000 0x00 0x1000 0x00 0x11f10000 0x00 0x1000 0x00 0x11d40000 0x00 0x1000 0x00 0x11d50000 0x00 0x1000 0x00 0x11e20000 0x00 0x1000 0x00 0x11e30000 0x00 0x1000 0x00 0x1000b000 0x00 0x1000>;
			reg-names = "gpio_base\0iocfg_tr_base\0iocfg_tm_base\0iocfg_tl_base\0iocfg_rt_base\0iocfg_rb_base\0iocfg_lt_base\0iocfg_lb_base\0eint";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0a 0x00 0x00 0x6c>;
			interrupt-controller;
			interrupts = <0x00 0xa3 0x04>;
			#interrupt-cells = <0x02>;
			pinctrl-names = "default";
			pinctrl-0 = <0x11>;
			phandle = <0x0a>;

			dsp_uart_pin {
				phandle = <0x15>;

				pins_rx {
					pinmux = <0xe02>;
					input-enable;
					bias-pull-up;
				};

				pins_tx {
					pinmux = <0xf02>;
				};
			};

			i2c0_pin {
				phandle = <0x19>;

				pins_bus {
					pinmux = <0x3401 0x3501>;
					bias-pull-up = <0xcf>;
					mediatek,drive-strength-adv = <0x07>;
				};
			};

			i2c1_pin {
				phandle = <0x1c>;

				pins_bus {
					pinmux = <0x3601 0x3701>;
					bias-pull-up = <0xcf>;
					mediatek,drive-strength-adv = <0x07>;
				};
			};

			i2c2_pin {
				phandle = <0x17>;

				pins_bus {
					pinmux = <0x4201 0x4301>;
					bias-pull-up = <0xcf>;
					mediatek,drive-strength-adv = <0x07>;
				};
			};

			i2c3_pin {
				phandle = <0x25>;

				pins_bus {
					pinmux = <0x5e01 0x5f01>;
					bias-pull-up = <0xcf>;
					mediatek,drive-strength-adv = <0x07>;
				};
			};

			i2c4_pin {
				phandle = <0x26>;

				pins_bus {
					pinmux = <0x401 0x501>;
					bias-pull-up = <0xcf>;
					mediatek,drive-strength-adv = <0x07>;
				};
			};

			mmc1default {
				phandle = <0x34>;

				pins_clk {
					pinmux = <0x5101>;
					drive-strength = <0x06>;
					bias-pull-down = <0x66>;
				};

				pins_cmd_dat {
					pinmux = <0x5001 0x4f01 0x4e01 0x4d01 0x5201>;
					input-enable;
					drive-strength = <0x06>;
					bias-pull-up = <0x65>;
				};
			};

			mmc1 {
				phandle = <0x35>;

				pins_clk {
					pinmux = <0x5101>;
					drive-strength = <0x06>;
					bias-pull-down = <0x66>;
				};

				pins_cmd_dat {
					pinmux = <0x5001 0x4f01 0x4e01 0x4d01 0x5201>;
					input-enable;
					drive-strength = <0x06>;
					bias-pull-up = <0x65>;
				};
			};

			dat1_eint {
				phandle = <0x36>;

				pins_dat1 {
					pinmux = <0x4f00>;
					input-enable;
					bias-pull-up = <0x65>;
				};
			};

			sdio_dat1 {
				phandle = <0x37>;

				pins_dat1 {
					pinmux = <0x4f01>;
					input-enable;
					bias-pull-up = <0x65>;
				};
			};

			nandcdefault {
				phandle = <0x2d>;

				pins_dat {
					pinmux = <0x1902 0x1a02 0x1b02 0x1602>;
					input-enable;
				};

				pins_cmd {
					pinmux = <0x1802 0x1702>;
					bias-pull-up;
				};
			};

			nandchigh {
				phandle = <0x2e>;

				pins_dat {
					pinmux = <0x1902 0x1a02 0x1b02 0x1602>;
					drive-strength = <0x04>;
					input-enable;
				};

				pins_cmd {
					pinmux = <0x1802 0x1702>;
					drive-strength = <0x04>;
					bias-pull-up;
				};
			};

			spim {
				phandle = <0x2a>;

				pins_spim {
					pinmux = <0x800 0x900 0xa00 0xb00 0x3d00 0x5300>;
					bias-disable;
					input-enable;
					bias-pull-down;
				};
			};

			spis0 {
				phandle = <0x2c>;

				pins_spis {
					pinmux = <0x5404 0x5504 0x5604>;
					bias-disable;
					input-enable;
				};
			};

			pmic_pins_eint {
				phandle = <0x1d>;

				pmic_pins {
					pinmux = <0x3100>;
					bias-disable;
				};
			};

			uart1_pin {
				phandle = <0x14>;

				uart1_pins {
					pinmux = <0xe01 0xf01>;
				};
			};

			pwmdefault {
				phandle = <0x1e>;

				pins_cmd_dat {
					pinmux = <0x605>;
				};
			};

			gpio_pin {
				phandle = <0x11>;

				gpio_pins {
					pinmux = <0xc00 0x3c00 0x3d00>;
					input-enable;
					bias-pull-up;
				};

				gpio_ol_pins {
					pinmux = <0x5400 0x1200 0x2f00 0x6100>;
					output-low;
				};

				gpio_pd_pins {
