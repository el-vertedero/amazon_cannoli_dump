		syscon@10006000 {
			compatible = "syscon\0simple-mfd";
			reg = <0x00 0x10006000 0x00 0x1000>;
			#power-domain-cells = <0x01>;
			phandle = <0x5f>;

			power-controller {
				compatible = "mediatek,mt8519-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;
				phandle = <0x20>;

				ssusbx@7 {
					reg = <0x07>;
					clocks = <0x0c 0x6e>;
					clock-names = "ssusbx0";
					mediatek,infracfg = <0x0d>;
					#power-domain-cells = <0x00>;
				};

				ip0@5 {
					reg = <0x05>;
					clocks = <0x12 0x00 0x12 0x02 0x12 0x01>;
					clock-names = "ip00\0ip01\0ip02";
					mediatek,infracfg = <0x0d>;
					#power-domain-cells = <0x00>;
				};

				ip1@6 {
					reg = <0x06>;
					clocks = <0x12 0x00 0x12 0x02 0x12 0x01>;
					clock-names = "ip00\0ip01\0ip02";
					mediatek,infracfg = <0x0d>;
					#power-domain-cells = <0x00>;
				};

				adsp_ao@4 {
					reg = <0x04>;
					clocks = <0x0c 0x1b 0x0c 0x22>;
					clock-names = "adsp_ao0\0adsp_ao1";
					mediatek,infracfg = <0x0d>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;

					adsp_infra@3 {
						reg = <0x03>;
						clocks = <0x0c 0x22>;
						clock-names = "adsp_infra0";
						mediatek,infracfg = <0x0d>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;

						adsp_top@2 {
							reg = <0x02>;
							clocks = <0x0c 0x1b 0x0c 0x22>;
							clock-names = "adsp_top0\0adsp_top1";
							mediatek,infracfg = <0x0d>;
							#power-domain-cells = <0x00>;
						};

						audsrc@1 {
							reg = <0x01>;
							mediatek,infracfg = <0x0d>;
							#power-domain-cells = <0x00>;
						};

						audio@0 {
							reg = <0x00>;
							mediatek,infracfg = <0x0d>;
							#power-domain-cells = <0x00>;
						};
					};
				};
			};
