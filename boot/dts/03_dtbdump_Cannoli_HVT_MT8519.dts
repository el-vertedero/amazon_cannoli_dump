	led_cooler {
		compatible = "amazon,thermal_cooler";
		#cooling-cells = <0x02>;
		max_state = <0x03>;
		phandle = <0xa4>;
	};

	display_cooler {
		compatible = "amazon,thermal_cooler";
		#cooling-cells = <0x02>;
		max_state = <0x03>;
		phandle = <0xa5>;
	};

	usb_vbus1@0 {
		compatible = "regulator-fixed";
		regulator-name = "usb1_vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x0a 0x14 0x00>;
		enable-active-high;
		phandle = <0x33>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		status = "okay";
		phandle = <0xa6>;

		button@0 {
			debounce-interval = <0x32>;
			label = "volumeup";
			linux,input-type = <0x01>;
			linux,code = <0x73>;
			gpios = <0x28 0x01 0x01>;
			swdebounce-interval = <0x64>;
			dyndebounce-interval = <0x00>;
			dyndebounce-duration = <0x2710>;
			phandle = <0xa7>;
		};

		button@1 {
			debounce-interval = <0x32>;
			label = "volumedown";
			linux,input-type = <0x01>;
			linux,code = <0x72>;
			gpios = <0x28 0x00 0x01>;
			swdebounce-interval = <0x64>;
			dyndebounce-interval = <0x00>;
			dyndebounce-duration = <0x2710>;
			phandle = <0xa8>;
		};

		button@2 {
			debounce-interval = <0x32>;
			label = "action";
			linux,input-type = <0x01>;
			linux,code = <0x8a>;
			gpios = <0x28 0x02 0x01>;
			swdebounce-interval = <0x64>;
			dyndebounce-interval = <0x00>;
			dyndebounce-duration = <0x2710>;
			phandle = <0xa9>;
		};
	};

	gpio-privacy {
		compatible = "gpio-privacy";
		status = "okay";
		enable-gpio = <0x28 0x07 0x00>;
		enable-gpio-toggle-duration = <0x32>;
		phandle = <0xaa>;

		state_event {
			label = "mute state";
			linux,input-type = <0x05>;
			linux,code = <0x0e>;
			gpios = <0x28 0x04 0x01>;
		};

		button_event {
			label = "mute";
			linux,input-type = <0x01>;
			linux,code = <0x71>;
			debounce-interval = <0x32>;
			gpios = <0x28 0x03 0x01>;
		};
	};

	led-sku-bias {
		compatible = "led-sku-bias";
		pinctrl-names = "default\0sku_bias_enabled\0sku_bias_disabled";
		pinctrl-0 = <0x45>;
		pinctrl-1 = <0x46>;
		pinctrl-2 = <0x45>;
		status = "okay";
		phandle = <0xab>;
	};

	thermal-zones {
		phandle = <0xac>;

		soc_max {
			polling-delay = <0x1f4>;
			polling-delay-passive = <0xc8>;
			thermal-sensors = <0x47 0xff>;
			sustainable-power = <0x5dc>;
		};

		cpu_little0 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x47 0x00>;
		};

		ADSP {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x47 0x01>;
		};

		IPNNA {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x47 0x02>;
		};

		cpu_little1 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x47 0x03>;
		};

		cpu_little2 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x47 0x04>;
		};

		cpu_little3 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x47 0x05>;
		};

		skin_virtual {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0x3a98>;
			policy = "step_wise";
			thermal-sensors = <0x48>;

			trips {

				trip-point@0 {
					temperature = <0xea60>;
					hysteresis = <0x1f4>;
					type = "critical";
					phandle = <0xad>;
				};
			};
		};

		case_virtual {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0x3a98>;
			policy = "step_wise";
			thermal-sensors = <0x49>;

			trips {

				trip-point@0 {
					temperature = <0xea60>;
					hysteresis = <0x1f4>;
					type = "critical";
					phandle = <0xae>;
				};
			};
		};

		back_virtual {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0x3a98>;
			policy = "step_wise";
			thermal-sensors = <0x4a>;
			phandle = <0xaf>;

			trips {

				trip-point@0 {
					temperature = <0xea60>;
					hysteresis = <0x1f4>;
					type = "critical";
					phandle = <0xb0>;
				};
			};
		};

		display_virtual {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0x3a98>;
			policy = "step_wise";
			thermal-sensors = <0x4b>;
			phandle = <0xb1>;

			trips {

				trip-point@0 {
					temperature = <0xea60>;
					hysteresis = <0x1f4>;
					type = "critical";
					phandle = <0xb2>;
				};
			};
		};

		cpu_virtual {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0x3a98>;
			policy = "step_wise";
			thermal-sensors = <0x4c>;
			phandle = <0xb3>;

			trips {

				trip-point@0 {
					temperature = <0x17ae8>;
					hysteresis = <0x1f4>;
					type = "critical";
					phandle = <0xb4>;
				};
			};
		};

		cpufilter_virtual {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0x3a98>;
			policy = "step_wise";
			thermal-sensors = <0x4d>;
			phandle = <0xb5>;
		};

		wifi_temp {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			policy = "step_wise";
			thermal-sensors = <0x4e>;
		};

		amp_temp {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			policy = "step_wise";
			thermal-sensors = <0x40>;
		};

		ap_ntc0 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x4f>;
			phandle = <0xb6>;
		};

		ap_ntc1 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x50>;
			phandle = <0xb7>;
		};

		ap_ntc2 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x51>;
			phandle = <0xb8>;
		};

		ap_ntc3 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x52>;
			phandle = <0xb9>;
		};

		ap_ntc4 {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x53>;
			phandle = <0xba>;
		};
	};

