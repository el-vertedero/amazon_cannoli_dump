on post-fs-data
    mkdir /data/commsd 0760 commsd commsd

# Audio mixer needs to be initialized before Comms can function.
on property:audio_mixer.init=true
    start commsd

service commsd /system/bin/commsd
    class main
    user commsd
    group aipc dbus ace_group inet
    # Must be explicitly started
    disabled
