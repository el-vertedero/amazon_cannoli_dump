on property:kvs_init_completed=1
    mkdir /dev/metricd 2777 system ace_group
    mkdir /data/vitals_aggregation 2770 system system
    start ace_metricd
service ace_metricd /system/bin/ace_metric_daemon
    setenv SHMLIB_DISABLE_ONLOAD true
    user system
    group system dbus aipc ace_group ace_kvstore inet ace_maplite
    disabled
