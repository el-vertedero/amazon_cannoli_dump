# Property triggers for NEO bootstrapper + DACD on-demand start.
# These are permanent — both bootstrapper (Path A) and DACD (Path B)
# work by setting this property; init.rc reacts.

on property:com.amazon.credmgr.run=1
    start credmgrsvc

on property:com.amazon.credmgr.run=0
    stop credmgrsvc

service credmgrsvc /system/bin/AceCredentialManagerService
    class main
    user credmgr
    group wifi credmgr ace_kvstore ace_group ace_maplite aipc inet dbus keystore
    disabled
