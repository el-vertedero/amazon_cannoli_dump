on post-fs-data
   start ledcontroller
   start boot2_anim_start

service ledcontroller /system/bin/ledcontroller
   class main
   user ledcontroller
   group aipc dbus als

service boot2_anim_start /system/bin/start_animation.sh anim_start_phase2
    user ledcontroller
    group dbus
    disabled
    oneshot
