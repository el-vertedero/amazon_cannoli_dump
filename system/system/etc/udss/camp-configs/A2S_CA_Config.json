{
    "description": "A2S GCA pipeline",
    "version": "1.0",
    "CAMPSchemaVersion": "1.0",
    "streams": [
        {
            "name": "A2S GenericCA",
            "type": "core.GenericCA",
            "args": {
                "capability": {
                    "discovery": {
                        "type": "AlexaInterface",
                        "interface": "Alexa.Input.GestureRecognizer.Tap",
                        "version": "1.0",
                        "configurations": {
                            "supportedGestures": ["SINGLE_TAP"],
                            "supportedActions": [
                                "SNOOZE_ALARM",
                                "DISMISS_ALERT",
                                "END_COMMUNICATION",
                                "PAUSE_RESUME_MEDIA"
                            ]
                          }
                    },
                    "directives": [
                        {
                            "name": "SetGestureConfiguration"
                        }
                    ]
                }
            }
        },
        {
            "name": "A2S SetGestureConfiguration Directive Accessor",
            "type": "core.json.accessor",
            "args": {
                "accessKey": "directive.payload.gestureConfiguration"
            },
            "inputs": [
                "GenericCA|Directives|Alexa.Input.GestureRecognizer.Tap|SetGestureConfiguration|IPCIn"
            ]
        },
        {
            "name": "A2S GestureConfiguration Setting Stream",
            "type": "core.setting",
            "args": {
                "settingName": "Alexa.Input.GestureRecognizer.Tap::gestureConfiguration"
            },
            "inputs": [
                "A2S SetGestureConfiguration Directive Accessor"
            ]
        },
        {
            "name": "A2S User Settings Stream 1",
            "type": "core.setting",
            "args": {
                "settingName": "Alexa.Input.GestureRecognizer.Tap::userChangedList"
            }
        },
        {
            "name": "A2S User Settings Editor",
            "type": "A2S.A2SUserSettingChangedCAMPStream",
            "inputs": [
                "GenericCA|Directives|Alexa.Input.GestureRecognizer.Tap|SetGestureConfiguration|IPCIn",
                "A2S User Settings Stream 1"
            ]
        },
        {
            "name": "A2S User Settings Stream 2",
            "type": "core.setting",
            "args": {
                "settingName": "Alexa.Input.GestureRecognizer.Tap::userChangedList"
            },
            "inputs": [
                "A2S User Settings Editor"
            ]
        },
        {
            "name": "GestureConfigurationReport event builder",
            "type": "A2S.A2SGCReportCAMPStream",
            "inputs": [
                "A2S GestureConfiguration Setting Stream"
            ]
        }
    ],
    "exec": [
        {
            "command": "connect",
            "input": "GestureConfigurationReport event builder",
            "consumer": "GenericCA|Events|Alexa.Input.GestureRecognizer.Tap|IPCOut"
        }
    ]
}