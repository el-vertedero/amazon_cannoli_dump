# ALS sysfs config
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* events/in_intensity0_thresh_falling_en 0664 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* events/in_intensity0_thresh_falling_value 0664 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* events/in_intensity0_thresh_period 0664 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* events/in_intensity0_thresh_rising_en 0664 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* events/in_intensity0_thresh_rising_value 0664 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* in_intensity0_raw 0444 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* in_intensity1_raw 0444 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* in_intensity_calibbias 0664 als als
/sys/devices/platform/soc/*/i2c-4/4-0039/iio:device* in_intensity_calibscale 0664 als als
