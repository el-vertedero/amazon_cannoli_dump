    # The common sysfs node for led_sku_bias
    chown ledcontroller ledcontroller /sys/devices/platform/led-sku-bias/led_sku_bias

    # On Cannoli 8519, PWM Channel 2 Controls the Mute LED PWM
    chown ledcontroller ledcontroller /sys/class/pwm/pwmchip0/pwm2/period
    chown ledcontroller ledcontroller /sys/class/pwm/pwmchip0/pwm2/duty_cycle
    chown ledcontroller ledcontroller /sys/class/pwm/pwmchip0/pwm2/enable

    # The sysfs node for MCU IPC
    chown ledcontroller ledcontroller /dev/tinysys_ipc_2

on post-fs-data
    mkdir /data/ledcontroller 0760 ledcontroller ledcontroller
    chown ledcontroller aipc /data/ledcontroller
    chown ledcontroller aipc /system/etc/led_mute_ring_config_1.json
    chown ledcontroller aipc /system/etc/led_mute_ring_config_2.json
    chown --reference=/system/etc/led_mute_ring_config.json /data/ledcontroller/led_mute_ring_config.json
