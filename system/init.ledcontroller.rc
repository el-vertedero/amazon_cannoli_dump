# Cannoli ledcontroller init config

on post-fs
    # On Cannoli 8519, PWM Channel 2 Controls the Mute LED PWM
    write /sys/class/pwm/pwmchip0/export "2"

on boot
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_0/color
